{
  "name": "srincrivel",
  "version": "2.0.0",
  "private": true,
  "main": "index.js",
  "type": "module",
  "engines": {
    "node": ">=26.0.0 <27"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env index.js",
    "check": "node scripts/check.js",
    "test": "node --test",
    "check:audio": "node scripts/check-audio.js",
    "check:extractor": "node scripts/check-extractor.js",
    "check:privacy": "node scripts/check-private-files.js",
    "setup:hooks": "git config core.hooksPath .githooks",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-include=\"src/**/*.js\""
  },
  "license": "ISC",
  "description": "Bot de Discord para música e áudios de entrada.",
  "dependencies": {
    "@discordjs/voice": "0.19.2",
    "@distube/yt-dlp": "2.0.1",
    "discord.js": "14.27.0",
    "distube": "5.2.3",
    "ffmpeg-static": "5.3.0",
    "opusscript": "0.0.8"
  },
  "allowScripts": {
    "@distube/yt-dlp@2.0.1": true,
    "ffmpeg-static@5.3.0": true
  }
}
